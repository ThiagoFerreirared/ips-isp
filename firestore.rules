rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public monitoring: occurrences and city names only.
    match /ocorrencias/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/cidades {
      allow get: if true;
      allow write: if request.auth != null;
    }
    // Existing authenticated operators retain access to the management system.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
